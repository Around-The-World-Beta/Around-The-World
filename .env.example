# Shared application configuration
APP_ENV=development
APP_URL=http://localhost:3000

# Browser-safe Supabase configuration.
# These values are public identifiers. Authorization must still be enforced by
# the API and database policies.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never expose these with a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
LOCATION_ENCRYPTION_KEY=

# Bot and abuse protection
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Observability. Do not send coordinates, tokens, emails, or profile text.
VITE_ERROR_REPORTING_DSN=
ERROR_REPORTING_DSN=

# Authentication redirects
AUTH_SITE_URL=http://localhost:3000
AUTH_ALLOWED_REDIRECT_URLS=http://localhost:3000/auth/callback
