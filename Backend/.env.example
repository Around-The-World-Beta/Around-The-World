# Copy to a local secrets file. Never commit real values. Never paste them into chat.
#
# Railway — paste these names on the service. Values come from Supabase, not from chat:
#   SUPABASE_JWT_SECRET
#   SUPABASE_URL
#   DATABASE_URL
# Optional on Railway:
#   CORS_ALLOWED_ORIGINS   (leave empty; the iPhone does not use CORS)
#   RATE_LIMIT_PER_MINUTE  (default 120)

# Required in production. Supabase → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# Recommended in production. Supabase → Project Settings → API → Project URL
# Example: https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Hosted Postgres. Supabase → Project Settings → Database → URI
DATABASE_URL=

# Optional. Comma-separated browser origins. Empty = native iOS only (recommended).
# Never set this to *
CORS_ALLOWED_ORIGINS=

# Optional. Requests per client IP per 60 seconds. Default 120.
RATE_LIMIT_PER_MINUTE=120

# Local-only (not needed on Railway)
# APP_ENV=development
# HOST=127.0.0.1
# PORT=8081
# DATABASE_DRIVER=sqlite
# SQLITE_PATH=around_the_world.sqlite
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USERNAME=atw
# DATABASE_PASSWORD=atw_dev_password
# DATABASE_NAME=around_the_world
# DATABASE_TLS=disable
# SEED_DEMO=1
